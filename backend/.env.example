# Copy to backend/.env and fill in for real use. All of these are optional —
# the app boots and Classic works with none of them set.

OPENAI_API_KEY=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Auth (Clerk) ---
CLERK_ISSUER_URL=
# Local/test only. When true, skips Clerk verification entirely and every
# request authenticates as "dev-user". Never set this in a real deployment.
AUTH_DEV_BYPASS=false

# --- Persistence (Supabase) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=

# V2 Session/Branch storage: "memory" (default, no setup needed) or
# "supabase" (durable — run docs/agents/v2-schema.sql on your Supabase
# project first, and set the two Supabase vars above).
V2_STORAGE_BACKEND=memory

# --- Observability (optional) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
