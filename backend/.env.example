# Copy to backend/.env and fill in for real use. The app boots and public theory
# tools work without credentials; Tutor and account storage need their settings.

OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Auth (Clerk) ---
CLERK_ISSUER_URL=
# Local/test only. When true, skips Clerk verification entirely and every
# request authenticates as "dev-user". Never set this in a real deployment.
AUTH_DEV_BYPASS=false

# --- Persistence (Supabase) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=

# V2 Session/Branch storage: "memory" (default, no setup needed) or
# "supabase" (durable; install the schema and both transaction RPCs as
# described in docs/agents/project.md, and set SUPABASE_URL/SUPABASE_SERVICE_KEY).
# Other values fail validation rather than silently using temporary storage.
V2_STORAGE_BACKEND=memory

# V2 tutor (ticket #13) — separate from V1's OPENAI_API_KEY/model selection
# above. "openai" | "anthropic" | "openrouter"; V2_TUTOR_MODEL optional
# (falls back to a per-provider default).
V2_TUTOR_PROVIDER=openai
V2_TUTOR_MODEL=

# --- Observability (optional) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
