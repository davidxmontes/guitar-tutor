# Copy to frontend/.env and fill in for real use.

VITE_API_BASE_URL=/api

# --- Auth (Clerk) ---
VITE_CLERK_PUBLISHABLE_KEY=
# Local/test only. When true, skips ClerkProvider entirely and the app
# renders as a fixed signed-in dev user. Never set this in a real deployment.
# Pair with the backend's AUTH_DEV_BYPASS=true so API calls also work.
VITE_AUTH_DEV_BYPASS=false
